# Facebook OAuth — récupérez ces valeurs dans Meta for Developers > Paramètres de l’application > Général.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Doit correspondre exactement à l’URI de redirection autorisée dans la configuration OAuth Meta.
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/integrations/facebook/callback

# Facultatif. À modifier uniquement si vous souhaitez cibler une autre version de l’API Graph.
FACEBOOK_GRAPH_API_VERSION=v23.0

# Planification de la veille multi-sources (Facebook, Google News, YouTube, flux RSS, Reddit).
FACEBOOK_AUTO_SEARCH=true
FACEBOOK_SEARCH_INTERVAL_MINUTES=15
FACEBOOK_SEARCH_BOOT_DELAY_MS=60000

# Recherche de Pages publiques Facebook : refusée par Meta sans App Review
# (Page Public Content Access). Laisser à false : seules les Pages
# administrées sont analysées.
FACEBOOK_PUBLIC_PAGE_SEARCH=false

# Google News : langue et pays par défaut des recherches (Paramètres → Mots-clés).
NEWS_DEFAULT_LANG=fr
NEWS_DEFAULT_COUNTRY=CM

# YouTube Data API v3 (facultatif) : sans clé, la source YouTube est ignorée.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Reddit (facultatif) : sans identifiants, la source Reddit est désactivée par
# défaut et considérée comme non configurée. Créez une application
# « script » sur https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Analyse sémantique Ollama (score de réputation des mentions).
# https://ollama.com — installer Ollama puis : ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000

# Facultatif. Jeton requis pour déclencher la collecte via un cron externe :
# GET /api/cron/facebook-search avec l’en-tête Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
